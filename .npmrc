# @relume_io/relume-ui@1.3.1 declares a peer of react@^18.2.0, and this project
# runs React 19. The conflict is a stale peer range rather than a real
# incompatibility — the components render correctly under 19 — but npm 7+
# treats it as fatal and aborts the install.
#
# Without this file `npm install` fails on a clean checkout and on every CI and
# Netlify build. Set here rather than passed as a flag so a contributor running
# a bare `npm install` gets the same resolution the deploy does.
#
# Remove it when relume-ui widens its peer range, and re-run `npm install` to
# confirm the tree still resolves before doing so.
legacy-peer-deps=true
